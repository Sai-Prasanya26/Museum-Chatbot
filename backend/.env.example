# ==========================================================
# Museum Booking System - Environment Variables
# ==========================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=museum_booking
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# UPI Payment Configuration
UPI_ID=museums.tickets@icici
UPI_MERCHANT_NAME=Museum Explorer Tickets
UPI_QR_IMAGE=/images/scanner.png

# Email Service Configuration (SMTP / Nodemailer)
# Configure with your SMTP provider (Gmail App Password, Brevo, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Museum Explorer Tickets" <no-reply@museumexplorer.in>

# WhatsApp Notification Configuration (Optional - Meta Cloud API / Twilio)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/
WHATSAPP_API_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

